# Solana RPC endpoint (used by scripts and Anchor)
# Get a free API key at https://helius.dev
ANCHOR_PROVIDER_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Solana wallet path (used by Anchor)
ANCHOR_WALLET=~/.config/solana/id.json

# Helius API key for frontend Vite proxy
VITE_HELIUS_API_KEY=YOUR_KEY_HERE
